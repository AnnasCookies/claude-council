# Optional HTTP provider credentials. An unset key disables only that provider route.
#
# These are deliberately prefixed `COUNCIL_` rather than using the bare vendor names
# (`XAI_API_KEY`, `ANTHROPIC_API_KEY`, …). Bare names are ambient: any agent harness, SDK or app
# that happens to load the surrounding directory will claim them and spend them. A key intended for
# one purpose was previously picked up and used for general-purpose inference by another tool.
# The prefix makes these keys inert to everything except this council.
#
# The outbound secret scanner still detects BOTH forms, because a leaked bare name in pasted
# evidence is exactly what must be blocked.
COUNCIL_XAI_API_KEY=
COUNCIL_DEEPSEEK_API_KEY=
COUNCIL_MOONSHOT_API_KEY=

# Anthropic, OpenAI and Google currently authenticate through local subscription CLIs
# (`claude`, `codex exec`, `agy`) and read no API key. When their metered API fallbacks land they
# will use COUNCIL_ANTHROPIC_API_KEY, COUNCIL_OPENAI_API_KEY and COUNCIL_GEMINI_API_KEY.

# Optional installer-supplied identity. The engine labels this as external provenance, not self-attestation.
COUNCIL_INSTALLER_PROVENANCE=
