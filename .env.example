# Optional HTTP provider credentials. An unset key disables only that provider route.
XAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# Anthropic, OpenAI and Google use authenticated local Claude, OMP and AGY
# subscription CLIs respectively. They never read API keys from this file.

# Optional installer-supplied identity. The engine labels this as external provenance, not self-attestation.
COUNCIL_INSTALLER_PROVENANCE=
